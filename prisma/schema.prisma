datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String       @id @default(uuid())
  email             String       @unique
  passwordHash      String
  name              String
  role              String       @default("STUDENT") // STUDENT | STAFF | ADMIN
  departmentId      String?
  department        Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  studentRollNumber String?
  phone             String?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  lastLoginAt       DateTime?

  complaintsSubmitted Complaint[]        @relation("StudentComplaints")
  complaintsAssigned  Complaint[]        @relation("StaffAssignedComplaints")
  complaintUpdates    ComplaintUpdate[]
  notifications       Notification[]
  feedbackGiven       Feedback[]
  auditLogs           AuditLog[]

  @@index([email])
  @@index([role])
  @@index([departmentId])
}

model Department {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users      User[]
  categories Category[]
  complaints Complaint[]

  @@index([code])
}

model Category {
  id           String      @id @default(uuid())
  name         String
  description  String?
  departmentId String
  department   Department  @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  complaints Complaint[]

  @@unique([name, departmentId])
  @@index([departmentId])
}

model Complaint {
  id                     String    @id @default(uuid())
  complaintNumber        String    @unique
  studentId              String
  student                User      @relation("StudentComplaints", fields: [studentId], references: [id], onDelete: Cascade)
  categoryId             String
  category               Category  @relation(fields: [categoryId], references: [id])
  departmentId           String
  department             Department @relation(fields: [departmentId], references: [id])
  assignedStaffId        String?
  assignedStaff          User?     @relation("StaffAssignedComplaints", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  
  title                  String
  description            String
  priority               String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status                 String    @default("PENDING") // PENDING | UNDER_REVIEW | ASSIGNED | IN_PROGRESS | WAITING_FOR_STUDENT | RESOLVED | REOPENED | REJECTED
  
  attachmentPath         String?
  attachmentOriginalName String?
  attachmentMimeType     String?
  
  resolutionMessage      String?
  rejectionReason        String?
  
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  resolvedAt             DateTime?
  rejectedAt             DateTime?

  updates  ComplaintUpdate[]
  feedback Feedback?

  @@index([complaintNumber])
  @@index([studentId])
  @@index([departmentId])
  @@index([assignedStaffId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model ComplaintUpdate {
  id             String    @id @default(uuid())
  complaintId    String
  complaint      Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  actorId        String
  actor          User      @relation(fields: [actorId], references: [id])
  
  updateType     String    @default("PUBLIC_UPDATE") // STATUS_CHANGE | PUBLIC_UPDATE | INTERNAL_NOTE | INFO_REQUEST | REASSIGNMENT | PRIORITY_CHANGE
  message        String
  previousStatus String?
  newStatus      String?
  isPublic       Boolean   @default(true)
  
  createdAt      DateTime  @default(now())

  @@index([complaintId])
  @@index([actorId])
  @@index([isPublic])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model Feedback {
  id          String    @id @default(uuid())
  complaintId String    @unique
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  studentId   String
  student     User      @relation(fields: [studentId], references: [id])
  rating      Int
  comment     String?
  createdAt   DateTime  @default(now())

  @@index([studentId])
  @@index([rating])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action       String
  resourceType String
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}
